{
  "name": "ratel-desktop",
  "version": "1.0.0",
  "description": "Ratel RBMS desktop shell — a lightweight installable/portable wrapper around the hosted web app.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ratel.rbms.desktop",
    "productName": "Ratel RBMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "offline.html"
    ],
    "win": {
      "target": ["portable", "nsis"]
    },
    "portable": {
      "artifactName": "RatelRBMS-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RatelRBMS-Setup-${version}.exe"
    }
  }
}
