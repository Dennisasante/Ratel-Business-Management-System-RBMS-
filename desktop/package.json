{
  "name": "ratel-desktop",
  "version": "1.0.0",
  "description": "Ratel RBMS desktop shell — a lightweight installable/portable wrapper around the hosted web app.",
  "main": "main.js",
  "author": "Ratel Systems",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ratel.rbms.desktop",
    "productName": "Ratel RBMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "offline.html",
      "assets/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "RatelRBMS-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RatelRBMS-Setup-${version}.exe"
    }
  }
}
