# Cafe Bar Noir demo stack — copy to `.env` next to docker-compose.demo.yml on
# the VPS (in its OWN directory, e.g. ~/ratel-demo — never inside the existing
# ~/ratel production checkout) and fill in real values. Gitignored pattern
# matches `.env` everywhere else in this repo — never commit the filled-in file.
#
# EVERY value below must be DIFFERENT from production's own `.env`. None of
# these are read from or copied out of production automatically — you type
# them in fresh. See CAFE_BAR_NOIR_DEMO_DEPLOY.md for the full walkthrough.

# --- Domain (DNS must point here before first `docker compose up`) ---
# This is the ONLY URL a client ever sees — the backend has no public domain
# of its own in this deployment (see the Caddy section of the deploy doc).
DOMAIN=demo.example.com
FRONTEND_URL=https://demo.example.com
# Used internally (CORS, links in emails that never actually send here) —
# does not need its own DNS record or Caddy route for this deployment shape.
BACKEND_URL=https://demo.example.com

# --- Database — an entirely separate Postgres instance/volume from production.
# Never reuse production's DB_NAME/DB_USERNAME/DB_PASSWORD. ---
DB_NAME=cafe_bar_noir_demo
DB_USERNAME=cafe_bar_noir_demo
DB_PASSWORD=<generate-a-new-random-value-see-below>

# --- JWT + per-business integration encryption ---
# Two DIFFERENT random strings from production's own JWT_SECRET/ENCRYPTION_KEY
# — a shared secret here would let a token/encrypted value from one
# environment be valid in the other, which defeats the whole point of
# isolating them. Generate with:
#   openssl rand -base64 48
JWT_SECRET=<generate-a-new-random-value>
ENCRYPTION_KEY=<generate-a-new-random-value>

# --- Tallia AI — the entire reason this is a separate stack ---
# "mock" activates MockAiProvider (see backend's own @ConditionalOnProperty on
# that class) — fully deterministic, makes zero external network calls, and
# does not read OPENAI_API_KEY at all. Leave the key line blank; nothing in
# this deployment will ever prompt for or require a real one.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Gates POST /api/platform/demo/seed-cafe-bar-noir — Super-Admin-only on top
# of this flag, not instead of it. Leave true only long enough to run the seed
# once, then set to false and restart the backend (see the deploy doc's
# "disable the seed" step). Safe to run the seed call again later if you ever
# need to reconcile the demo tenant — it's idempotent by business slug.
DEMO_SEED_ENABLED=true

# --- Super Admin bootstrap — a DEMO-ONLY account, never production's ---
# Only takes effect on this stack's own first startup (its own fresh database
# has no Super Admin yet). Use a password you haven't used anywhere else.
SUPER_ADMIN_EMAIL=admin@demo.example.com
SUPER_ADMIN_PASSWORD=<strong-demo-only-password>
SUPER_ADMIN_NAME=Demo Super Admin

# --- Everything below: genuinely not needed for this demo. Leave blank —
# each feature quietly no-ops when its config is blank, exactly like
# production's own optional values do. Do NOT paste production's real values
# in here "just in case" — that would silently give the demo stack the
# ability to send real email / accept real payments / push real
# notifications, which defeats the isolation this whole deployment is for. ---
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@demo.example.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@demo.example.com
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
