# URL of the Spring Boot backend. Used by next.config.js to proxy /api/* requests
# so the browser never has to deal with CORS directly.
NEXT_PUBLIC_API_URL=http://localhost:8090

# Google OAuth Client ID (from Google Cloud Console) — powers the "Continue with
# Google" button on /login and /register. Must match GOOGLE_CLIENT_ID on the
# backend. See backend/README.md for setup steps. Leave unset to disable the
# Google button (email/password still works fine without it).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
