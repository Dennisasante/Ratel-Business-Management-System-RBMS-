# Copy relevant values into real environment variables (not this file directly —
# it's just a reference; application.yml reads from the environment).

# --- Database (defaults match docker-compose.yml, fine for local dev) ---
DB_USERNAME=ratel_user
DB_PASSWORD=ratel_pass

# --- JWT ---
# Use a long random string in anything beyond local dev.
JWT_SECRET=change-this-to-a-long-random-secret-in-your-env-vars-please
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of origins allowed to call the API directly.
# Not usually needed in dev since the frontend proxies through next.config.js.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google Sign-In ---
# See "Google Sign-In setup" in README.md. Must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# See "Email (SMTP) setup" in README.md. Recommended: Brevo (free tier, plain SMTP).
# Required for password reset emails to actually send — without these, reset
# requests still succeed but no email goes out (logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@ratel.app
FRONTEND_URL=http://localhost:3000

# --- File uploads (business logos) ---
# Local disk storage — see "Business logo storage" in README.md for the
# object-storage caveat if you ever move off a single-server VPS.
UPLOAD_DIR=./uploads

# --- Daily digest ---
# Cron expression; default is 6:00 AM UTC (= 6:00 AM Ghana time, no offset needed).
DIGEST_CRON=0 0 6 * * *

# --- Super Admin bootstrap ---
# Set these, start the app once to create the account, then unset them again.
# See "Super Admin (platform-level access)" in README.md.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
