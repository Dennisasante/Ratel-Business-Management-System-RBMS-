# Copy relevant values into real environment variables (not this file directly —
# it's just a reference; application.yml reads from the environment).

# --- Database (defaults match docker-compose.yml, fine for local dev) ---
DB_USERNAME=ratel_user
DB_PASSWORD=ratel_pass

# --- JWT ---
# Use a long random string in anything beyond local dev.
JWT_SECRET=change-this-to-a-long-random-secret-in-your-env-vars-please
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of origins allowed to call the API directly.
# Not usually needed in dev since the frontend proxies through next.config.js.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google Sign-In ---
# See "Google Sign-In setup" in README.md. Must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# See "Email (SMTP) setup" in README.md. Recommended: Brevo (free tier, plain SMTP).
# Required for password reset emails to actually send — without these, reset
# requests still succeed but no email goes out (logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@ratel.app
FRONTEND_URL=http://localhost:3000

# Publicly-reachable backend URL, once deployed — WooCommerce delivers order
# webhooks here. Leave as localhost for local dev (webhook registration still
# works against the real WooCommerce API; live delivery needs a public URL).
BACKEND_URL=http://localhost:8090

# --- File uploads (business logos) ---
# Local disk storage — see "Business logo storage" in README.md for the
# object-storage caveat if you ever move off a single-server VPS.
UPLOAD_DIR=./uploads

# --- Daily digest ---
# Cron expression; default is 6:00 AM UTC (= 6:00 AM Ghana time, no offset needed).
DIGEST_CRON=0 0 6 * * *

# --- Super Admin bootstrap ---
# Set these, start the app once to create the account, then unset them again.
# See "Super Admin (platform-level access)" in README.md.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Paystack (subscription billing) ---
# From your Paystack dashboard (Settings > API Keys & Webhooks). Secret key is
# backend-only (never sent to the browser); public key powers the frontend
# Inline JS checkout popup.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Encryption (per-business integration secrets) ---
# Encrypts each business's own Paystack/WooCommerce keys at rest (they pay
# their own customers' bookings/orders through these, separate from the
# PAYSTACK_SECRET_KEY above). Long random string, same as JWT_SECRET.
ENCRYPTION_KEY=

# --- Push notifications (Web Push / VAPID) ---
# Generate once with `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY here
# must exactly match NEXT_PUBLIC_VAPID_PUBLIC_KEY in frontend/.env.local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Tallia AI provider (Phase 1) ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API / Meta Graph API (Tallia AI Phase 3B) ---
# These are PLATFORM-level (shared by every business's WhatsApp binding);
# each business's own Phone Number ID/access token is entered separately by
# a Super Admin (see "WhatsApp channel setup" in README.md) and stored
# encrypted on that business's own AiChannelBinding row.
#
# Meta Graph API version — bump this here only, never hardcode it elsewhere.
WHATSAPP_GRAPH_API_VERSION=v21.0
# Arbitrary string YOU choose and enter into Meta's App Dashboard webhook
# config as the "Verify Token" — proves a verification request really came
# from your own Meta App, not a guess.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret (App Dashboard > Settings > Basic) — verifies the
# X-Hub-Signature-256 HMAC on every inbound webhook event. Leaving this
# blank means every inbound WhatsApp event is rejected (fails closed).
META_APP_SECRET=
