# Copy this to `.env` next to docker-compose.prod.yml on the VPS and fill in
# real values. `.env` is gitignored — never commit it. See DEPLOY.md for the
# full walkthrough of where each of these comes from.

# --- Domains (DNS must already point here before first `docker compose up`) ---
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# --- Database ---
DB_NAME=ratel_db
DB_USERNAME=ratel_user
DB_PASSWORD=change-this-to-a-long-random-value

# --- JWT + per-business integration encryption ---
# Two different long random strings — generate with: openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=

# --- Google Sign-In (optional — leave blank to disable the Google button) ---
# See "Google Sign-In setup" in backend/README.md.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# See "Email (SMTP) setup" in backend/README.md. Recommended: Brevo (free tier).
# Without these, password-reset/digest emails silently no-op instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com

# --- Paystack (RBMS's own subscription billing — NOT each business's own
# Paystack keys, which they enter themselves in Integrations) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Push notifications (Web Push / VAPID) ---
# Generate once with `npx web-push generate-vapid-keys`. Feeds both the
# backend (VAPID_PRIVATE_KEY signs each push) and the frontend build
# (VAPID_PUBLIC_KEY is baked in as NEXT_PUBLIC_VAPID_PUBLIC_KEY automatically
# — see docker-compose.prod.yml). Without these, the app runs fine but the
# "Enable push notifications" toggle fails with "not set up on this server".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Tallia AI ---
# AI_PROVIDER selects which AiProvider bean runs: "openai" (real model calls)
# or "mock" (deterministic demo provider, no external call — see
# MockAiProvider). Leaving this unset defaults to mock, which is a
# local-dev convenience ONLY — set this explicitly to "openai" here for any
# real deployment, since production must never silently fall back to the
# mock provider.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gates POST /api/platform/demo/seed-resort (creates the fictional "Paradise
# Beach Resort (Demo)" business for sales demos). Leave false/unset in
# production — this is on top of that endpoint already being
# Super-Admin-only.
DEMO_SEED_ENABLED=false

# --- Tallia AI: WhatsApp Cloud API (Phase 3B) ---
# Platform-level config, shared by every business's WhatsApp binding — each
# business's own Phone Number ID + access token is entered by a Super Admin
# afterward (see backend/README.md's "WhatsApp channel setup") and stored
# encrypted, never here. The webhook itself is served at
# https://{API_DOMAIN}/api/webhooks/whatsapp — that's the exact URL to give
# Meta's App Dashboard.
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Super Admin bootstrap ---
# Set for the FIRST deploy only — the backend creates this account on startup
# if no Super Admin exists yet, then leaves it alone on every later restart
# even if these stay set. Log in once after first deploy, then you may blank
# these out (optional, not required).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
